<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="equipment_return_wizard_view_form" model="ir.ui.view">
        <field name="name">equipment.return.wizard.form</field>
        <field name="model">equipment.return.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="equipment_ids" widget="many2many_tags" readonly="1"/>
                        <field name="date_end"/>
                    </group>
                    <group>
                        <field name="condition_in"/>
                        <field name="destination_state" widget="radio"/>
                    </group>
                </group>
                <field name="note" placeholder="Missing charger, scratches..."/>
                <footer>
                    <button name="action_confirm" type="object" string="Return" class="oe_highlight" data-hotkey="q"/>
                    <button string="Discard" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
