<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="equipment_assignment_view_list" model="ir.ui.view">
        <field name="name">equipment.assignment.list</field>
        <field name="model">equipment.assignment</field>
        <field name="arch" type="xml">
            <list create="0" sample="1"
                  decoration-danger="not date_end and expected_return_date and expected_return_date &lt; current_date"
                  decoration-muted="state == 'returned'">
                <field name="name" optional="show"/>
                <field name="equipment_id"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="department_id" optional="hide"/>
                <field name="category_id" optional="show"/>
                <field name="date_start"/>
                <field name="expected_return_date" optional="show"/>
                <field name="date_end"/>
                <field name="duration_days" optional="show"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <button name="action_open_return_wizard" type="object" string="Return" icon="fa-undo"
                        invisible="state != 'ongoing'"/>
                <field name="state" widget="badge" decoration-info="state == 'ongoing'" decoration-muted="state == 'returned'"/>
            </list>
        </field>
    </record>

    <record id="equipment_assignment_view_form" model="ir.ui.view">
        <field name="name">equipment.assignment.form</field>
        <field name="model">equipment.assignment</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_open_return_wizard" type="object" string="Return" class="oe_highlight"
                            invisible="state != 'ongoing'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="equipment_id" readonly="1"/>
                            <field name="employee_id" readonly="1" widget="many2one_avatar_employee"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="category_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Handover">
                            <field name="date_start" readonly="not can_correct_dates"/>
                            <field name="expected_return_date" readonly="1"/>
                            <field name="condition_out" readonly="1"/>
                            <field name="assigned_by_id" widget="many2one_avatar_user"/>
                            <field name="note_out"/>
                        </group>
                        <group string="Return" invisible="state != 'returned'">
                            <field name="date_end" readonly="not can_correct_dates"/>
                            <field name="duration_days"/>
                            <field name="condition_in" readonly="1"/>
                            <field name="returned_by_id" widget="many2one_avatar_user"/>
                            <field name="note_in"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="equipment_assignment_view_search" model="ir.ui.view">
        <field name="name">equipment.assignment.search</field>
        <field name="model">equipment.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="equipment_id"/>
                <field name="employee_id"/>
                <field name="department_id" operator="child_of"/>
                <field name="category_id" operator="child_of"/>
                <field name="name"/>
                <filter name="ongoing" string="Ongoing" domain="[('state', '=', 'ongoing')]"/>
                <filter name="returned" string="Returned" domain="[('state', '=', 'returned')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="returned_damaged" string="Returned Damaged" domain="[('condition_in', '=', 'damaged')]"/>
                <separator/>
                <filter name="last_12_months" string="Last 12 Months"
                        domain="[('date_start', '&gt;=', (context_today() - relativedelta(months=12)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_date_start" string="Handover Date" date="date_start"/>
                <separator/>
                <filter name="my_handovers" string="My Handovers" domain="[('assigned_by_id', '=', uid)]"/>
                <group>
                    <filter name="groupby_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="groupby_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="groupby_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="groupby_equipment" string="Equipment" context="{'group_by': 'equipment_id'}"/>
                    <filter name="groupby_start_month" string="Handover Month" context="{'group_by': 'date_start:month'}"/>
                    <filter name="groupby_end_month" string="Return Month" context="{'group_by': 'date_end:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="equipment_assignment_view_pivot" model="ir.ui.view">
        <field name="name">equipment.assignment.pivot</field>
        <field name="model">equipment.assignment</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="department_id" type="row"/>
                <field name="date_start" interval="month" type="col"/>
                <field name="duration_days" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="equipment_assignment_view_graph" model="ir.ui.view">
        <field name="name">equipment.assignment.graph</field>
        <field name="model">equipment.assignment</field>
        <field name="arch" type="xml">
            <graph type="line" sample="1">
                <field name="date_start" interval="month"/>
                <field name="department_id"/>
            </graph>
        </field>
    </record>

    <record id="equipment_assignment_ongoing_action" model="ir.actions.act_window">
        <field name="name">Ongoing Assignments</field>
        <field name="res_model">equipment.assignment</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="equipment_assignment_view_search"/>
        <field name="context">{'search_default_ongoing': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is handed over right now</p>
            <p>Use Assign on an available equipment to hand it over to an employee.</p>
        </field>
    </record>

    <record id="equipment_assignment_history_action" model="ir.actions.act_window">
        <field name="name">Assignment History</field>
        <field name="res_model">equipment.assignment</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="equipment_assignment_view_search"/>
        <field name="context">{'search_default_last_12_months': 1}</field>
    </record>

    <record id="equipment_assignment_analysis_action" model="ir.actions.act_window">
        <field name="name">Assignment Analysis</field>
        <field name="res_model">equipment.assignment</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="equipment_assignment_view_search"/>
    </record>
</odoo>
