<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.form.equipment</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_equipment_items" type="object" class="oe_stat_button" icon="fa-laptop"
                        groups="equipment_assignment.group_equipment_officer">
                    <field name="equipment_item_count" widget="statinfo" string="Equipment"/>
                </button>
                <button name="action_view_equipment_history" type="object" class="oe_stat_button" icon="fa-history"
                        groups="equipment_assignment.group_equipment_officer">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Equipment History</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
