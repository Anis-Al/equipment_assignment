<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="equipment_item_view_list" model="ir.ui.view">
        <field name="name">equipment.item.list</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <list sample="1" decoration-danger="state == 'assigned' and expected_return_date and expected_return_date &lt; current_date">
                <field name="reference"/>
                <field name="name"/>
                <field name="category_id" optional="show"/>
                <field name="current_employee_id" widget="many2one_avatar_employee"/>
                <field name="current_department_id" optional="hide"/>
                <field name="assigned_since" optional="show"/>
                <field name="expected_return_date" optional="show"
                       decoration-danger="state == 'assigned' and expected_return_date and expected_return_date &lt; current_date"/>
                <field name="serial_number" optional="hide"/>
                <field name="purchase_date" optional="hide"/>
                <field name="purchase_value" optional="hide" groups="equipment_assignment.group_equipment_manager"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-info="state == 'assigned'"
                       decoration-warning="state == 'maintenance'"
                       decoration-muted="state == 'retired'"/>
            </list>
        </field>
    </record>

    <record id="equipment_item_view_kanban" model="ir.ui.view">
        <field name="name">equipment.item.kanban</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="0" group_create="0" quick_create="0" sample="1">
                <field name="expected_return_date"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside t-if="record.image_128.raw_value" class="me-2">
                            <field name="image_128" widget="image" options="{'size': [64, 64], 'img_class': 'object-fit-contain'}"/>
                        </aside>
                        <main>
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="reference" class="text-muted small"/>
                            <field name="category_id" class="small"/>
                            <footer>
                                <span class="badge text-bg-danger"
                                      invisible="state != 'assigned' or not expected_return_date or expected_return_date &gt;= current_date">Overdue</span>
                                <div class="d-flex ms-auto align-items-center">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                    <field name="current_employee_id" widget="many2one_avatar_employee" class="ms-1"/>
                                </div>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="equipment_item_view_form" model="ir.ui.view">
        <field name="name">equipment.item.form</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_assign_wizard" type="object" string="Assign" class="oe_highlight"
                            invisible="state != 'available'" data-hotkey="a"/>
                    <button name="action_open_return_wizard" type="object" string="Return" class="oe_highlight"
                            invisible="state != 'assigned'" data-hotkey="r"/>
                    <button name="action_open_transfer_wizard" type="object" string="Transfer"
                            invisible="state != 'assigned'" data-hotkey="t"/>
                    <button name="action_send_to_maintenance" type="object" string="Send to Maintenance"
                            invisible="state != 'available'"/>
                    <button name="action_set_available" type="object" string="Back to Available"
                            invisible="state != 'maintenance'"/>
                    <button name="action_set_available" type="object" string="Restore"
                            invisible="state != 'retired'" groups="equipment_assignment.group_equipment_manager"/>
                    <button name="action_retire" type="object" string="Retire"
                            invisible="state not in ('available', 'maintenance')"
                            groups="equipment_assignment.group_equipment_manager"
                            confirm="Retire this equipment? It will be archived and disappear from the default views."/>
                    <field name="state" widget="statusbar" statusbar_visible="available,assigned,maintenance"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assignments" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="assignment_count" widget="statinfo" string="History"/>
                        </button>
                        <button name="action_view_holder" type="object" class="oe_stat_button" icon="fa-user"
                                invisible="state != 'assigned'">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Holder</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Retired" bg_color="text-bg-secondary" invisible="active"/>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Dell Latitude 5440"/></h1>
                        <h3><field name="reference" class="text-muted"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="serial_number"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Current Situation" invisible="state != 'assigned'">
                        <group>
                            <field name="current_employee_id" widget="many2one_avatar_employee"/>
                            <field name="current_department_id"/>
                        </group>
                        <group>
                            <field name="assigned_since"/>
                            <field name="expected_return_date" decoration-danger="is_overdue"/>
                        </group>
                    </group>
                    <div class="text-muted mb-3" invisible="state != 'available' or not last_return_date">
                        Available since <field name="last_return_date" class="oe_inline"/>
                    </div>
                    <notebook>
                        <page string="Details" name="details">
                            <group>
                                <group>
                                    <field name="purchase_date"/>
                                    <field name="purchase_value" groups="equipment_assignment.group_equipment_manager"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                                <group>
                                    <field name="warranty_end_date"/>
                                    <field name="vendor_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Accessories delivered, configuration, known defects..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="equipment_item_view_search" model="ir.ui.view">
        <field name="name">equipment.item.search</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_name" string="Equipment"/>
                <field name="current_employee_id"/>
                <field name="current_department_id" operator="child_of"/>
                <field name="category_id" operator="child_of"/>
                <field name="serial_number"/>
                <filter name="available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="assigned" string="Assigned" domain="[('state', '=', 'assigned')]"/>
                <filter name="maintenance" string="In Maintenance" domain="[('state', '=', 'maintenance')]"/>
                <separator/>
                <filter name="overdue" string="Overdue Return" domain="[('is_overdue', '=', True)]"/>
                <filter name="idle" string="Idle 90+ Days"
                        domain="[('state', '=', 'available'), '|',
                                 ('last_return_date', '&lt;', (context_today() - relativedelta(days=90)).strftime('%Y-%m-%d')),
                                 '&amp;', ('last_return_date', '=', False),
                                 ('create_date', '&lt;', (context_today() - relativedelta(days=90)).strftime('%Y-%m-%d'))]"/>
                <filter name="warranty_expiring" string="Warranty Expiring (60 days)"
                        domain="[('warranty_end_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('warranty_end_date', '&lt;=', (context_today() + relativedelta(days=60)).strftime('%Y-%m-%d'))]"/>
                <filter name="warranty_expired" string="Warranty Expired"
                        domain="[('warranty_end_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="retired" string="Retired" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="groupby_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="groupby_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="groupby_holder" string="Holder" context="{'group_by': 'current_employee_id'}"/>
                    <filter name="groupby_department" string="Department" context="{'group_by': 'current_department_id'}"/>
                    <filter name="groupby_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                    <filter name="groupby_purchase_year" string="Purchase Year" context="{'group_by': 'purchase_date:year'}"/>
                </group>
                <searchpanel>
                    <field name="category_id" icon="fa-folder" select="one" enable_counters="0"/>
                    <field name="state" icon="fa-circle" select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="equipment_item_view_pivot" model="ir.ui.view">
        <field name="name">equipment.item.pivot</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="category_id" type="row"/>
                <field name="state" type="col"/>
                <field name="purchase_value" type="measure" groups="equipment_assignment.group_equipment_manager"/>
            </pivot>
        </field>
    </record>

    <record id="equipment_item_view_graph" model="ir.ui.view">
        <field name="name">equipment.item.graph</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1" sample="1">
                <field name="category_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="equipment_item_action" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">equipment.item</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="equipment_item_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first equipment</p>
            <p>Laptops, phones, tools: register each item once, then hand it over and get it back in two clicks.</p>
        </field>
    </record>

    <record id="equipment_item_analysis_action" model="ir.actions.act_window">
        <field name="name">Equipment Analysis</field>
        <field name="res_model">equipment.item</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="equipment_item_view_search"/>
    </record>

    <record id="equipment_item_assign_binding_action" model="ir.actions.act_window">
        <field name="name">Assign</field>
        <field name="res_model">equipment.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_equipment_item"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="group_ids" eval="[(4, ref('group_equipment_officer'))]"/>
    </record>

    <record id="equipment_item_return_binding_action" model="ir.actions.act_window">
        <field name="name">Return</field>
        <field name="res_model">equipment.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_equipment_item"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="group_ids" eval="[(4, ref('group_equipment_officer'))]"/>
    </record>
</odoo>
