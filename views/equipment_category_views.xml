<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="equipment_category_view_list" model="ir.ui.view">
        <field name="name">equipment.category.list</field>
        <field name="model">equipment.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="display_name" string="Category"/>
            </list>
        </field>
    </record>

    <record id="equipment_category_view_form" model="ir.ui.view">
        <field name="name">equipment.category.form</field>
        <field name="model">equipment.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_items" type="object" class="oe_stat_button" icon="fa-laptop">
                            <field name="item_count" widget="statinfo" string="Equipment"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Laptops"/></h1>
                    </div>
                    <group>
                        <field name="parent_id"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="equipment_category_view_search" model="ir.ui.view">
        <field name="name">equipment.category.search</field>
        <field name="model">equipment.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_name" string="Category"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="equipment_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">equipment.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
